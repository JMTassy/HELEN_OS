{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rho_summary.schema.json",
  "title": "RHO Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "inf_rho", "t_star", "active_constraint", "margins_at_t_star"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["RHO_SUMMARY_V1"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "inf_rho": { "type": "number" },
    "t_star":  { "type": "integer", "minimum": 0 },
    "active_constraint": {
      "type": "string",
      "enum": ["mu_Delta", "mu_Pi", "mu_CFL", "mu_Lyap", "mu_Z"]
    },
    "margins_at_t_star": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mu_Delta", "mu_Pi", "mu_CFL", "mu_Lyap", "mu_Z", "rho"],
      "properties": {
        "mu_Delta": { "type": "number" },
        "mu_Pi":    { "type": "number" },
        "mu_CFL":   { "type": "number" },
        "mu_Lyap":  { "type": "number" },
        "mu_Z":     { "type": "number" },
        "rho":      { "type": "number" }
      }
    }
  }
}
