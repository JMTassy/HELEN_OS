{
  "id": "obliteratus_v0",
  "version": 0,
  "state_owner": "workflow_engine",
  "nodes": [
    {"id": "gamma", "kind": "source", "principal": "admission_seat",
     "consumes": [], "produces": ["audit.write"], "grants": ["audit.write"],
     "cost_class": "CHEAP"},
    {"id": "freeze", "kind": "compute", "principal": "her_freeze",
     "consumes": ["frozen_corpus", "frozen_config"],
     "produces": ["frozen", "bid"], "grants": [], "cost_class": "STANDARD",
     "writes_state": true, "resume_contract": {"key": "bid"}},
    {"id": "baseline", "kind": "compute", "principal": "her_baseline",
     "consumes": ["frozen"], "produces": ["baseline_run"], "grants": [],
     "cost_class": "STRONG", "writes_state": true,
     "resume_contract": {"key": "raw_base"}},
    {"id": "score_baseline", "kind": "compute", "principal": "evaluator",
     "consumes": ["baseline_run"], "produces": ["score_base"],
     "grants": [], "cost_class": "STANDARD"},
    {"id": "cluster", "kind": "compute", "principal": "her_cluster",
     "consumes": ["score_base"], "produces": ["clusters"], "grants": [],
     "cost_class": "STANDARD"},
    {"id": "select_surgery", "kind": "decision", "principal": "policy_engine",
     "consumes": ["clusters"], "produces": ["surgery"], "grants": [],
     "cost_class": "STANDARD"},
    {"id": "targeted_1", "kind": "compute", "principal": "her_probe",
     "consumes": ["surgery"], "produces": ["t1"], "grants": [],
     "cost_class": "STANDARD", "evidence_root": "cluster_probe_1"},
    {"id": "targeted_2", "kind": "compute", "principal": "her_probe",
     "consumes": ["surgery"], "produces": ["t2"], "grants": [],
     "cost_class": "STANDARD", "evidence_root": "cluster_probe_2"},
    {"id": "targeted_3", "kind": "compute", "principal": "her_probe",
     "consumes": ["surgery"], "produces": ["t3"], "grants": [],
     "cost_class": "STANDARD", "evidence_root": "cluster_probe_3"},
    {"id": "targeted_4", "kind": "compute", "principal": "her_probe",
     "consumes": ["surgery"], "produces": ["t4"], "grants": [],
     "cost_class": "STANDARD", "evidence_root": "cluster_probe_4"},
    {"id": "full_corpus", "kind": "compute", "principal": "evaluator",
     "consumes": ["surgery", "t1", "t2", "t3", "t4"],
     "produces": ["candidate_run"], "grants": [], "cost_class": "STRONG",
     "writes_state": true, "resume_contract": {"key": "raw_cand"}},
    {"id": "score", "kind": "compute", "principal": "evaluator",
     "consumes": ["candidate_run"], "produces": ["score_cand"],
     "grants": [], "cost_class": "STANDARD"},
    {"id": "compare_runs", "kind": "compute", "principal": "comparator",
     "consumes": ["score_cand", "score_base"], "produces": ["comparison"],
     "grants": [], "cost_class": "STANDARD"},
    {"id": "replay_1", "kind": "compute", "principal": "her_replay_1",
     "consumes": ["comparison"], "produces": ["r1"], "grants": [],
     "cost_class": "STRONG", "writes_state": true,
     "resume_contract": {"key": "replay1"}},
    {"id": "replay_2", "kind": "compute", "principal": "her_replay_2",
     "consumes": ["comparison"], "produces": ["r2"], "grants": [],
     "cost_class": "STRONG", "writes_state": true,
     "resume_contract": {"key": "replay2"}},
    {"id": "verify_receipt", "kind": "verify", "principal": "verifier_seat",
     "consumes": ["r1", "r2"], "produces": ["verdict"], "grants": [],
     "cost_class": "STANDARD", "consequential": true,
     "admission_boundary": "PASS|HOLD|REVERT",
     "verifier_contract": {"producer_principal": "her_replay_1",
       "verifier_principal": "admission_seat",
       "evidence_roots": ["replay1", "replay2"],
       "method": "deterministic_replay"}},
    {"id": "publish_result", "kind": "effect", "principal": "runtime",
     "consumes": ["verdict"], "produces": ["audit_event"],
     "grants": ["audit.write"], "cost_class": "CHEAP",
     "writes_state": true, "resume_contract": {"key": "publish", "idempotent": true},
     "admission_boundary": "gamma",
     "idempotency_key": "${graph_id}:${run_id}:publish_result",
     "effect_contract": {"capability": "audit.write",
       "idempotency_key": "${graph_id}:${run_id}:publish_result",
       "admission_boundary": "gamma"}}
  ],
  "edges": [
    {"from": "freeze", "to": "baseline", "type": "DATA", "artifact": "frozen"},
    {"from": "baseline", "to": "score_baseline", "type": "DATA", "artifact": "baseline_run"},
    {"from": "score_baseline", "to": "cluster", "type": "DATA", "artifact": "score_base"},
    {"from": "cluster", "to": "select_surgery", "type": "DATA", "artifact": "clusters"},
    {"from": "select_surgery", "to": "targeted_1", "type": "DATA", "artifact": "surgery"},
    {"from": "select_surgery", "to": "targeted_2", "type": "DATA", "artifact": "surgery"},
    {"from": "select_surgery", "to": "targeted_3", "type": "DATA", "artifact": "surgery"},
    {"from": "select_surgery", "to": "targeted_4", "type": "DATA", "artifact": "surgery"},
    {"from": "select_surgery", "to": "full_corpus", "type": "DATA", "artifact": "surgery"},
    {"from": "targeted_1", "to": "full_corpus", "type": "DATA", "artifact": "t1"},
    {"from": "targeted_2", "to": "full_corpus", "type": "DATA", "artifact": "t2"},
    {"from": "targeted_3", "to": "full_corpus", "type": "DATA", "artifact": "t3"},
    {"from": "targeted_4", "to": "full_corpus", "type": "DATA", "artifact": "t4"},
    {"from": "full_corpus", "to": "score", "type": "DATA", "artifact": "candidate_run"},
    {"from": "score", "to": "compare_runs", "type": "DATA", "artifact": "score_cand"},
    {"from": "compare_runs", "to": "replay_1", "type": "DATA", "artifact": "comparison"},
    {"from": "compare_runs", "to": "replay_2", "type": "DATA", "artifact": "comparison"},
    {"from": "replay_1", "to": "verify_receipt", "type": "DATA", "artifact": "r1"},
    {"from": "replay_2", "to": "verify_receipt", "type": "DATA", "artifact": "r2"},
    {"from": "verify_receipt", "to": "publish_result", "type": "DECISION"},
    {"from": "gamma", "to": "publish_result", "type": "AUTHORITY", "grant": "audit.write", "admitted": true}
  ],
  "joins": [
    {"id": "targeted_join", "at_node": "full_corpus",
     "required": ["t1", "t2", "t3", "t4"], "coverage": 1.0,
     "on_failure": "HOLD", "on_timeout": "HOLD",
     "next_needs_complete_set": true},
    {"id": "replay_join", "at_node": "verify_receipt",
     "required": ["replay_1", "replay_2"], "coverage": 1.0,
     "on_failure": "HOLD", "on_timeout": "HOLD",
     "next_needs_complete_set": true}
  ],
  "routes": [
    {"id": "verdict_route", "classifier_output": "comparison",
     "deterministic_rule": "acceptance_gate", "destination": "PASS|HOLD|REVERT",
     "model_controlled_destination": false}
  ],
  "grants": [
    {"capability": "audit.write", "to_node": "publish_result",
     "via_edge": "gamma->publish_result", "admitted_by": "gamma"}
  ],
  "observational_contract": {
    "schema_equal": true, "business_state_equal": true,
    "admitted_effects_equal": true, "policy_decisions_equal": true,
    "required_evidence_equivalent": true
  }
}
