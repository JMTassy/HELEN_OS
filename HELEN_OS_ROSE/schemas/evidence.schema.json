{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence register entry",
  "description": "One line of research/evidence_register.jsonl. Classes indicate strength of support for the specific claim, not universal truth.",
  "type": "object",
  "required": ["claim", "evidence_class", "source", "date", "scope", "limitations"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-[0-9]{3}$"},
    "claim": {"type": "string", "minLength": 3},
    "evidence_class": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "source": {"type": "string"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scope": {"type": "string"},
    "limitations": {"type": "string"}
  },
  "additionalProperties": true
}
