{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "helen.run-packet.v0",
  "title": "HELEN Run Packet V0",
  "description": "The ONLY artifact form HELEN reasons over. Raw provider output is an attachment, never evidence. A packet is produced exclusively by .helen/bin/normalize.py, which signs it with a normalizer_seal derived from the packet content plus the normalizer version. Packets lacking a valid seal are refused by every downstream consumer.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "task_id",
    "provider",
    "model",
    "role",
    "authority",
    "mutation_allowed",
    "started_at",
    "input_hash",
    "output_hash",
    "observations",
    "inferences",
    "proposals",
    "files_changed",
    "commands_run",
    "tests",
    "evidence_refs",
    "errors",
    "exit_code",
    "normalizer_version",
    "normalizer_seal"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "helen.run-packet.v0" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "role": { "type": "string" },
    "authority": { "const": false },
    "mutation_allowed": { "type": "boolean" },
    "started_at": { "type": "string" },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "output_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source_ref"],
        "properties": {
          "text": { "type": "string" },
          "source_ref": { "type": "string" }
        }
      }
    },
    "inferences": { "type": "array", "items": { "type": "string" } },
    "proposals": { "type": "array", "items": { "type": "string" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "object" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "exit_code": { "type": "integer" },
    "normalizer_version": { "type": "string" },
    "normalizer_seal": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "raw_attachment": {
      "type": "string",
      "description": "Path to the raw provider output. Retained for provenance. Carries NO authority and is never parsed as evidence."
    }
  }
}
